# Sanity (create a project at https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Shared secret configured on the Sanity webhook (Settings > API > Webhooks)
# that hits /api/revalidate, so publishing content goes live without a redeploy.
SANITY_REVALIDATE_SECRET=

# Resend (https://resend.com) — used by /api/contact to email form submissions.
# If left unset, submissions are logged instead of emailed (useful for local dev).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
